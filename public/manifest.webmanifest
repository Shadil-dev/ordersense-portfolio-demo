{
  "name": "OrderSense",
  "short_name": "OrderSense",
  "description": "OrderSense workspace for reorder forecasting, consumption insights, purchase planning, CRM, and accounts receivable follow-ups.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#eef2f7",
  "theme_color": "#2563eb",
  "categories": ["business", "productivity", "finance"],
  "icons": [
    {
      "src": "/ordersense.svg",
      "sizes": "120x120",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Accounts Receivable",
      "short_name": "Accounts",
      "description": "Open collections, invoice follow-ups, and credit risk.",
      "url": "/#accounts",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Sales CRM",
      "short_name": "CRM",
      "description": "Open sales customer actions and relationship tracking.",
      "url": "/#ceo-group-crm",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Purchase Planning",
      "short_name": "Planning",
      "description": "Open reorder and purchase planning insights.",
      "url": "/#purchase-planning",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
